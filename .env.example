# HASHLENS — Environment Configuration Template

# =============================================================================
# 1. CORE APPLICATION SETTINGS
# =============================================================================
APP_NAME=HashLens
APP_ENV=development # development | production
DEBUG=false

# =============================================================================
# 2. LOCAL DEVELOPMENT BINDINGS
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# =============================================================================
# 3. RENDER DEPLOYMENT OVERRIDES (Automated in render.yaml)
# =============================================================================
# Dashboard Service Backend Target URL:
# API_URL=https://<your-backend-service-name>.onrender.com
#
# Backend Service CORS Origin Override:
# ALLOWED_ORIGINS=https://<your-dashboard-service-name>.onrender.com

# =============================================================================
# 4. SECURITY & I/O BOUNDS
# =============================================================================
MAX_UPLOAD_SIZE=104857600  # 100 MB max upload limit (in bytes)
DEFAULT_CHUNK_SIZE=1048576 # 1 MB chunk fingerprint size (in bytes)
RATE_LIMIT_REQUESTS=120    # Sliding window request threshold
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_HSTS=false          # Set to true only after verifying production HTTPS routing
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# 5. PERSISTENCE & LOGGING
# =============================================================================
DATABASE_URL=sqlite:///./data/hashlens.db
LOG_LEVEL=INFO
