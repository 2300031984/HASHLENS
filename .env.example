# Environment Configuration for HashLens
APP_NAME=HashLens
APP_ENV=development
DEBUG=false

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Security & Upload Limits
MAX_UPLOAD_SIZE=104857600  # 100 MB default in bytes (100 * 1024 * 1024)
DEFAULT_CHUNK_SIZE=1048576 # 1 MB chunk size
RATE_LIMIT_REQUESTS=120    # requests per minute per IP
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_HSTS=false          # Set to true only behind HTTPS deployment proxies
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# Persistence
DATABASE_URL=sqlite:///./data/hashlens.db

# Logging
LOG_LEVEL=INFO
